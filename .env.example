# MORGUL Store - Midtrans Configuration
PORT=3000

# Midtrans Access Keys (Obtain from https://dashboard.sandbox.midtrans.com or https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE

# Environment Mode: false for Sandbox (Testing), true for Production (Live)
MIDTRANS_IS_PRODUCTION=false

# Game Top Up Provider Configuration (vipreseller | digiflazz | simulation)
PROVIDER_NAME=simulation
PROVIDER_API_ID=YOUR_PROVIDER_API_ID
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY
PROVIDER_SIGNATURE=YOUR_PROVIDER_SIGNATURE_OR_SECRET
PROVIDER_MARGIN_PERCENT=10

